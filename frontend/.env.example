# ===========================================
# ThalCare Frontend Environment Configuration
# Copy this file to .env and update values
# ===========================================

# API Configuration
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_API_TIMEOUT=30000

# Application Settings
VITE_APP_NAME=ThalCare
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# Authentication
VITE_JWT_STORAGE_KEY=thalcare_token
VITE_REFRESH_TOKEN_KEY=thalcare_refresh_token
VITE_USER_STORAGE_KEY=thalcare_user

# Feature Flags
VITE_ENABLE_ML_PREDICTIONS=true
VITE_ENABLE_DNA_RECOMMENDATIONS=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_FILE_UPLOAD=true

# Upload Configuration
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=.csv,.pdf,.xlsx

# Session Configuration
VITE_SESSION_TIMEOUT=3600000
VITE_TOKEN_REFRESH_INTERVAL=300000

# Logging
VITE_ENABLE_LOGGING=true
VITE_LOG_LEVEL=debug
